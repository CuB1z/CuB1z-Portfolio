---
interface Props {
    name: "mail" | "copy" | "check" | "github" | "linkedin";
    class?: string;
}

const { name, class: className, ...attrs } = Astro.props;
---

<span
    {...attrs}
    class:list={["icon", className]}
    style={`--button-icon-image: url("/icons/${name}.svg")`}
    aria-hidden="true"
></span>

<style>
    .icon {
        flex: none;
        width: var(--button-icon-size, 18px);
        height: var(--button-icon-size, 18px);
        background-color: currentColor;
        mask: var(--button-icon-image) center / contain no-repeat;
    }
</style>
