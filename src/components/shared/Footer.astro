---
import { useTranslations } from "@utils/i18nUtils";
import { socialData } from "@/constants/socialData";

const t = useTranslations(Astro.currentLocale);

const year = new Date().getFullYear();
const email = socialData.email.replace(/^mailto:/, "");
---

<footer>
    <div class="shell foot-bar">
        <span>© {year} {t("common:footer_rights")}</span>
        <ul>
            <li><a href={socialData.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={socialData.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href={socialData.email}>{email}</a></li>
        </ul>
    </div>
</footer>

<style>
    .foot-bar {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 8px 24px;
        padding-top: 24px;
        padding-bottom: 32px;
        font-size: 13px;
        color: var(--mute);
    }
    ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 20px;
    }
    a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--accent);
    }
    a:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    @media (max-width: 734px) {
        .foot-bar {
            flex-direction: column;
            text-align: center;
        }
        ul {
            justify-content: center;
        }
    }
</style>
