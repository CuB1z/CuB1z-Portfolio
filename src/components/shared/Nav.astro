---
import { useTranslations } from "@utils/i18nUtils";
import { buildUrl } from "@utils/urlUtils";

interface Props {
    home?: boolean;
    active?: string;
    altLangUrl?: string;
}

const { home = false, active, altLangUrl } = Astro.props;
const locale = Astro.currentLocale;
const t = useTranslations(locale);
const homeHref = buildUrl("/", locale);
const sectionBase = home ? "" : homeHref;
const items = ["experience", "work", "about", "writing"].map((id) => ({
    id,
    label: t(`common:nav.${id}`),
    href: id === "writing" && !home ? buildUrl("/blog", locale) : `${sectionBase}#${id}`,
}));

const currentPath = Astro.url.pathname;
const cleanPath = currentPath.replace(/^\/es/, "") || "/";
const otherLocale = locale === "es" ? "en" : "es";
const otherPath = altLangUrl ?? (locale === "es" ? cleanPath : `/es${cleanPath}`);
---

<nav class="nav">
    <div class="nav-in">
        <a href={homeHref} class="logo-link" aria-label={locale === "es" ? "Inicio" : "Home"}>
            <img src="/logo.svg" alt="" width="339" height="116" />
        </a>
        <div class="nav-links">
            {
                items.map((item) => (
                    <a href={item.href} class:list={{ active: active === item.id }}>
                        {item.label}
                    </a>
                ))
            }
        </div>
        <a
            class="lang"
            href={otherPath}
            lang={otherLocale}
            hreflang={otherLocale}
            aria-label={otherLocale === "es" ? "Ver en español" : "View in English"}
        >
            {otherLocale.toUpperCase()}
        </a>
    </div>
</nav>

<style>
    .nav {
        position: fixed;
        top: 12px;
        left: 0;
        right: 0;
        z-index: 60;
        pointer-events: none;
    }
    .nav-in {
        pointer-events: auto;
        width: min(var(--max-width), calc(100% - 24px));
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 6px 6px 6px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(16, 20, 26, 0.72);
        backdrop-filter: blur(20px) saturate(180%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }
    .logo-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 8px;
        margin-right: auto;
    }
    .logo-link img {
        height: 20px;
        width: auto;
        display: block;
    }
    .nav-links {
        display: flex;
        gap: 2px;
    }
    .nav-links a {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0 16px;
        border-radius: 999px;
        font-size: 15px;
        white-space: nowrap;
        transition: background-color 0.2s, color 0.2s;
    }
    .nav-links a:hover {
        background: var(--fill);
    }
    .nav-links a.active {
        color: var(--accent);
        background: rgba(255, 255, 255, 0.04);
    }
    .lang {
        flex: none;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--fill);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.04em;
        transition: color 0.2s;
    }
    .lang:hover {
        color: var(--accent);
    }
    @media (max-width: 734px) {
        .nav-in {
            padding-left: 8px;
        }
        .nav-links {
            display: none;
        }
    }
</style>
