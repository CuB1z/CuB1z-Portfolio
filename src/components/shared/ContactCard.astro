---
import { socialData } from "@/constants/socialData";
import { useTranslations } from "@utils/i18nUtils";
import ButtonIcon from "./ButtonIcon.astro";

const t = useTranslations(Astro.currentLocale);
---

<article class="group contact-card" aria-labelledby="contact-name">
    <div class="identity">
        <img src="/images/diego-192.webp" width="56" height="56" alt="" loading="lazy" decoding="async" />
        <div>
            <h3 id="contact-name">Diego Sánchez Rincón</h3>
            <p>{t("common:schema.jobTitle")} · {t("resume:about.location")}</p>
        </div>
    </div>
    <ul class="actions">
        <li>
            <a href="/contact.vcf" download="Diego-Sanchez.vcf">
                <ButtonIcon name="download" />
                {t("resume:about.saveContact")}
            </a>
        </li>
        <li>
            <a href={socialData.email}>
                <ButtonIcon name="mail" />
                {t("resume:about.email")}
            </a>
        </li>
        <li>
            <a href={socialData.linkedin} target="_blank" rel="noopener noreferrer">
                <ButtonIcon name="linkedin" />
                LinkedIn
                <ButtonIcon name="arrow-up-right" class="external" />
            </a>
        </li>
    </ul>
</article>

<script>
    const glintMotion = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");

    document.addEventListener("astro:page-load", () => {
        const card = document.querySelector<HTMLElement>(".contact-card");
        if (!card) return;

        card.onpointermove = (event) => {
            if (!glintMotion.matches || event.pointerType !== "mouse") return;

            const bounds = card.getBoundingClientRect();
            card.style.setProperty("--glint-x", `${(event.clientX - bounds.left) / bounds.width * 100}%`);
            card.style.setProperty("--glint-y", `${(event.clientY - bounds.top) / bounds.height * 100}%`);
        };
    });
</script>

<style>
    @property --glint-x {
        syntax: "<percentage>";
        inherits: true;
        initial-value: 50%;
    }
    @property --glint-y {
        syntax: "<percentage>";
        inherits: true;
        initial-value: 50%;
    }

    .contact-card {
        position: relative;
        display: grid;
        grid-template-rows: 1fr auto;
        min-width: 0;
        padding: 0 20px 8px;
    }
    .identity {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: 16px;
        padding-block: 20px;
    }
    .identity img {
        object-fit: cover;
        border-radius: 50%;
    }
    .identity h3 {
        font-size: 20px;
        text-wrap: pretty;
    }
    .identity p {
        margin-top: 4px;
        color: var(--soft);
        font-size: 14px;
    }
    .actions {
        --button-icon-size: 16px;
        list-style: none;
    }
    .actions a {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        border-top: 1px solid var(--rule);
        color: var(--ink);
        font-size: 14px;
    }
    .actions a:is(:hover, :focus-visible) {
        color: var(--accent);
    }
    .actions :global(.external) {
        margin-left: auto;
    }
    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
        @supports (mask-composite: exclude) {
            .contact-card {
                transition: --glint-x 260ms ease-out, --glint-y 260ms ease-out;
            }
            .contact-card::before {
                content: "";
                position: absolute;
                inset: 0;
                padding: 1px;
                border-radius: inherit;
                background: radial-gradient(
                    circle 150px at var(--glint-x, 50%) var(--glint-y, 50%),
                    color-mix(in srgb, var(--accent) 68%, white),
                    color-mix(in srgb, var(--accent) 55%, transparent) 32%,
                    transparent 86%
                );
                mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
                mask-composite: exclude;
                opacity: 0;
                pointer-events: none;
                transition: opacity 340ms ease;
            }
            .contact-card:hover::before {
                opacity: .65;
            }
        }
    }
</style>
