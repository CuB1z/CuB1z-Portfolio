---
import ContactCard from "@components/shared/ContactCard.astro";
import { useTranslations } from "@utils/i18nUtils";

const t = useTranslations(Astro.currentLocale);

const heading = t("resume:about.heading");
const narrative = t("resume:about.narrative", { returnObjects: true }) as string[];
---

<section id="about" class="section">
    <div class="shell">
        <h2 class="sec-title">{heading}</h2>

        <div class="about">
            <div class="prose">
                {narrative.map((p) => <p>{p}</p>)}
                <div class="details">
                    <p>{t("resume:about.education")}</p>
                    <p>{t("resume:about.languages")}</p>
                </div>
            </div>
            <ContactCard />
        </div>
    </div>
</section>

<style>
    .about {
        display: grid;
        gap: 32px;
        font-weight: 400;
    }
    .prose {
        display: grid;
        align-content: center;
        gap: 16px;
        max-width: 36em;
        line-height: 1.6;
    }
    .details {
        border-top: 1px solid var(--rule);
        padding-top: 12px;
        color: var(--soft);
        font-size: 14px;
    }
    @media (min-width: 900px) {
        .about {
            grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        }
    }
</style>
