---
import { useTranslations } from "@utils/i18nUtils";
import { buildUrl } from "@/utils/urlUtils";
import Chevron from "@components/shared/Chevron.astro";

const locale = Astro.currentLocale;
const t = useTranslations(locale);

interface Project {
    title: string;
    featured?: boolean;
    page?: string;
    flag?: string;
    image?: string;
    description: string;
    techStack: string[];
    links: { github: string | null; live: string | null };
}

const heading = t("projects:heading");
const projects = t("projects:projects", { returnObjects: true }) as Project[];

const featured = projects.find((p) => p.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured);

// JSON-LD so AI can read each project even without a dedicated page.
const projectsLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: heading,
    itemListElement: projects.map((p, i) => {
        const sameAs = [p.links.live, p.links.github].filter(Boolean);
        const url = p.page
            ? new URL(`${p.page}/`, Astro.site).toString()
            : (p.links.live ?? p.links.github);
        return {
            "@type": "ListItem",
            position: i + 1,
            item: {
                "@type": "CreativeWork",
                name: p.title,
                description: p.description,
                inLanguage: locale,
                ...(url ? { url } : {}),
                ...(sameAs.length ? { sameAs } : {}),
                keywords: p.techStack.join(", "),
            },
        };
    }),
};
---

<section id="work" class="section">
    <script
        type="application/ld+json"
        set:html={JSON.stringify(projectsLd)}
    />
    <div class="shell">
        <h2 class="sec-title">{heading}</h2>

        <article class="feature">
            <div class="feature-text">
                {featured.flag && <p class="kicker">{featured.flag}</p>}
                <h3>{featured.title}</h3>
                <p>{featured.description}</p>
                <ul class="tags">{featured.techStack.map((tech) => <li>{tech}</li>)}</ul>
                {featured.page && (
                    <a class="more" href={buildUrl(featured.page, locale)}>
                        {t("projects:case_study")}
                        <Chevron />
                    </a>
                )}
            </div>
            {featured.image && <img src={featured.image} alt={featured.title} loading="lazy" />}
        </article>

        <h3 class="sub">{t("projects:other_heading")}</h3>
        <ul class="tiles">
            {
                rest.map((project) => {
                    const href = project.links.live ?? project.links.github;
                    const Tag = href ? "a" : "div";
                    return (
                        <li>
                            <Tag
                                class="tile"
                                href={href ?? undefined}
                                target={href ? "_blank" : undefined}
                                rel={href ? "noopener noreferrer" : undefined}
                            >
                                <span class="tile-name">
                                    {project.title}
                                    {href && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>}
                                </span>
                                <p>{project.description}</p>
                                <span class="tags">{project.techStack.map((tech) => <span>{tech}</span>)}</span>
                            </Tag>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>

<style>
    .feature {
        display: grid;
        background: var(--bg-card);
        border-radius: var(--radius);
        overflow: hidden;
    }
    .feature-text {
        display: grid;
        gap: 12px;
        align-content: center;
        padding: 32px;
        min-width: 0;
    }
    .kicker {
        font-size: 13px;
        font-weight: 600;
        color: var(--soft);
    }
    .feature h3 {
        font-size: 32px;
        line-height: 1.1;
        letter-spacing: -0.025em;
    }
    .feature img {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }
    .tiles {
        list-style: none;
        display: grid;
        gap: 12px;
    }
    .tile {
        display: grid;
        gap: 6px;
        align-content: start;
        height: 100%;
        padding: 20px 22px;
        border-radius: 18px;
        background: var(--bg-card);
        transition: background-color 0.2s;
    }
    a.tile:hover {
        background: var(--bg-card-2);
    }
    .tile-name {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        font-weight: 600;
    }
    .tile-name svg {
        width: 16px;
        height: 16px;
        flex: none;
        margin-top: 3px;
        color: var(--accent);
    }
    .tile p {
        font-size: 15px;
        color: var(--soft);
    }
    .tile .tags {
        margin-top: 6px;
    }
    @media (min-width: 640px) {
        .tiles {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (min-width: 900px) {
        .feature {
            grid-template-columns: 1fr 1.15fr;
        }
    }
    @media (max-width: 899px) {
        .feature img {
            display: none;
        }
    }
</style>
