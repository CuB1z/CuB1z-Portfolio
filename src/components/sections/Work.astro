---
import { useTranslations } from "@utils/i18nUtils";
import { buildUrl } from "@/utils/urlUtils";
import ButtonIcon from "@components/shared/ButtonIcon.astro";
import Chevron from "@components/shared/Chevron.astro";

const locale = Astro.currentLocale;
const t = useTranslations(locale);

interface Project {
    title: string;
    page?: string;
    image: string;
    action: string;
    description: string;
    techStack: string[];
    links: { github: string | null; live: string | null };
}

const heading = t("projects:heading");
const projects = (t("projects:projects", { returnObjects: true }) as Project[]).map((project) => ({
    ...project,
    href: project.page ? buildUrl(project.page, locale) : (project.links.live ?? project.links.github),
}));

// JSON-LD so AI can read each project even without a dedicated page.
const projectsLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: heading,
    itemListElement: projects.map((p, i) => {
        const sameAs = [p.links.live, p.links.github].filter(Boolean);
        return {
            "@type": "ListItem",
            position: i + 1,
            item: {
                "@type": "CreativeWork",
                name: p.title,
                description: p.description,
                inLanguage: locale,
                ...(p.href ? { url: new URL(p.href, Astro.site).href } : {}),
                ...(sameAs.length ? { sameAs } : {}),
                keywords: p.techStack.join(", "),
            },
        };
    }),
};
---

<section id="work" class="section" aria-labelledby="work-title">
    <script
        type="application/ld+json"
        set:html={JSON.stringify(projectsLd)}
    />
    <div class="shell">
        <h2 class="sec-title" id="work-title">{heading}</h2>
        <ul class="group" role="list">
            {
                projects.map((project) => {
                    const { href } = project;
                    const external = Boolean(href && !project.page);
                    const Row = href ? "a" : "div";

                    return (
                        <li>
                            <Row
                                class="project-row"
                                href={href ?? undefined}
                                target={external ? "_blank" : undefined}
                                rel={external ? "noopener noreferrer" : undefined}
                            >
                                <img src={project.image} alt="" width="640" height="360" loading="lazy" decoding="async" />
                                <div class="project-copy">
                                    <h3>{project.title}</h3>
                                    <p>{project.description}</p>
                                </div>
                                {href && (
                                    <span class="project-action">
                                        {project.action}
                                        {external ? <ButtonIcon name="arrow-up-right" /> : <Chevron />}
                                    </span>
                                )}
                            </Row>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>

<style>
    .project-row {
        display: grid;
        grid-template-columns: 128px minmax(0, 1fr) auto;
        align-items: center;
        gap: 16px;
        padding: 16px 24px;
    }
    a.project-row:is(:hover, :focus-visible) {
        background: var(--bg-card-2);
    }
    .project-row:focus-visible {
        outline-offset: -3px;
    }
    .project-row img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 8px;
    }
    .project-copy h3 {
        font-size: 18px;
        margin-bottom: 4px;
    }
    .project-copy p,
    .project-action {
        font-size: 14px;
    }
    .project-copy p {
        color: var(--soft);
        max-width: 54ch;
    }
    .project-action {
        --button-icon-size: 16px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--accent);
    }
    @media (max-width: 734px) {
        .project-row {
            grid-template-columns: 88px minmax(0, 1fr);
            grid-template-areas:
                "image title"
                "image action"
                "description description";
            gap: 8px 12px;
            padding: 20px;
        }
        .project-row img {
            grid-area: image;
        }
        .project-copy {
            display: contents;
        }
        .project-copy h3 {
            grid-area: title;
            align-self: end;
            margin-bottom: 0;
        }
        .project-copy p {
            grid-area: description;
            margin-top: 8px;
        }
        .project-action {
            grid-area: action;
            align-self: start;
        }
    }
</style>
