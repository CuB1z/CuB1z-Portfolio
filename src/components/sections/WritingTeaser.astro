---
import { getCollection } from "astro:content";
import { useTranslations } from "@utils/i18nUtils";
import { buildUrl } from "@utils/urlUtils";
import Chevron from "@components/shared/Chevron.astro";
import PostRow from "@components/shared/PostRow.astro";

const t = useTranslations(Astro.currentLocale);

const locale = Astro.currentLocale;

const allPosts = await getCollection("post");
const posts = allPosts
    .filter((post) => (post.data.locale ?? "en") === locale && post.data.showcase)
    .sort(
        (a, b) =>
            new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    )
    .slice(0, 2);
---

<section id="writing" class="section">
    <div class="shell">
        <h2 class="sec-title">{t("blog:teaser_heading")}</h2>

        <ul class="group">
            {posts.map((post) => <PostRow post={post} excerpt />)}
        </ul>

        <a class="more" href={buildUrl("/blog", locale)}>
            {t("blog:all_posts")}
            <Chevron />
        </a>
    </div>
</section>

<style>
    .more {
        margin-top: 8px;
    }
</style>
