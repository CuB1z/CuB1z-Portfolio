---
import { useTranslations } from "@utils/i18nUtils";

const t = useTranslations(Astro.currentLocale);

const heading = t("resume:experience.heading");
const items = t("resume:experience.items", { returnObjects: true }) as Array<{
    role: string;
    company: string;
    type: string;
    date: string;
    lead: string;
    bullets: string[];
    tags: string[];
}>;
---

<section id="experience" class="section">
    <div class="shell">
        <h2 class="sec-title">{heading}</h2>

        <ul class="group timeline">
            {
                items.map((item) => (
                    <li class="role">
                        <div class="role-head">
                            <div>
                                <h3>{item.role}</h3>
                                <p class="org">{item.company}</p>
                            </div>
                            <div class="meta">
                                <span class="chip">{item.type}</span>
                                <span>{item.date}</span>
                            </div>
                        </div>
                        <p class="lead">{item.lead}</p>
                        <ul class="bullets">
                            {item.bullets.map((b) => (
                                <li>{b}</li>
                            ))}
                        </ul>
                        <ul class="tags">
                            {item.tags.map((tg) => (
                                <li>{tg}</li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .org {
        font-size: 15px;
        font-weight: 600;
        color: var(--accent);
    }
    .lead,
    .bullets {
        max-width: 760px;
    }
    .bullets {
        display: grid;
        gap: 6px;
        padding-left: 18px;
        list-style: disc;
        font-size: 15px;
        color: color-mix(in srgb, var(--ink) 55%, var(--soft));
    }
    .bullets li::marker {
        color: var(--accent);
    }
    .tags {
        margin-top: 2px;
    }
</style>
