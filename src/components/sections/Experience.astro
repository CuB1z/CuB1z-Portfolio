---
import Button from "@components/shared/Button.astro";
import { useTranslations } from "@utils/i18nUtils";

const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);
const cvUrl = `/cv/Diego_Sanchez_${locale.toUpperCase()}.pdf`;

const heading = t("resume:experience.heading");
const items = t("resume:experience.items", { returnObjects: true }) as Array<{
    role: string;
    company: string;
    type: string;
    date: string;
    lead: string;
    bullets: string[];
    tags: string[];
}>;
---

<section id="experience" class="section">
    <div class="shell">
        <div class="experience-heading">
            <h2 class="sec-title">{heading}</h2>
            <Button href={cvUrl} download="" icon="download">
                {t("resume:experience.downloadCv")}
            </Button>
        </div>

        <ul class="group timeline">
            {
                items.map((item) => (
                    <li class="role">
                        <div class="role-head">
                            <div>
                                <h3>{item.role}</h3>
                                <p class="org">{item.company}</p>
                            </div>
                            <div class="meta">
                                <span class="chip">{item.type}</span>
                                <span>{item.date}</span>
                            </div>
                        </div>
                        <p class="lead">{item.lead}</p>
                        <ul class="bullets">
                            {item.bullets.map((b) => (
                                <li>{b}</li>
                            ))}
                        </ul>
                        <ul class="tags">
                            {item.tags.map((tg) => (
                                <li>{tg}</li>
                            ))}
                        </ul>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .section {
        margin-top: 8px;
    }
    .experience-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px 16px;
        margin-bottom: 24px;
    }
    .experience-heading .sec-title {
        margin: 0;
    }
    .org {
        font-size: 15px;
        font-weight: 600;
        color: var(--accent);
    }
    .lead,
    .bullets {
        max-width: 760px;
    }
    .bullets {
        display: grid;
        gap: 6px;
        padding-left: 18px;
        list-style: disc;
        font-size: 15px;
        color: color-mix(in srgb, var(--ink) 55%, var(--soft));
    }
    .bullets li::marker {
        color: var(--accent);
    }
    .tags {
        margin-top: 2px;
    }
</style>
