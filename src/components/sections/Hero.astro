---
import { useTranslations } from "@utils/i18nUtils";
import { socialData } from "@/constants/socialData";

const t = useTranslations(Astro.currentLocale);

const email = socialData.email.replace(/^mailto:/, "");
---

<header class="hero">
    <div class="shell">
        <h1>{t("hero:name")}</h1>
        <p class="lede" set:html={t("hero:lede")} />
        <p class="bio" set:html={t("hero:bio")} />
        <div class="actions">
            <button
                class="btn primary"
                id="copy-email"
                type="button"
                data-email={email}
                data-copied={t("hero:copied")}
                data-copied-msg={t("hero:copied_msg")}
                data-selected-msg={t("hero:selected_msg")}
            >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="3.5"/><path d="m3.5 7.5 7.4 5.1a2 2 0 0 0 2.2 0l7.4-5.1"/></svg>
                <span class="vh">{t("hero:copy")} </span><span class="email">{email}</span>
                <svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"/></svg>
                <svg class="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            </button>
            <a class="btn" href={socialData.github} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                GitHub
            </a>
            <a class="btn" href={socialData.linkedin} target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12" rx="1"/><circle cx="4" cy="4" r="2"/></svg>
                LinkedIn
            </a>
        </div>
        <p class="vh" id="copy-status" role="status"></p>
    </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        const btn = document.querySelector<HTMLButtonElement>("#copy-email");
        const label = btn?.querySelector<HTMLElement>(".email");
        const status = document.querySelector<HTMLElement>("#copy-status");
        if (!btn || !label || !status) return;
        const { email = "", copied = "", copiedMsg = "", selectedMsg = "" } = btn.dataset;
        let timer: number | undefined;
        btn.onclick = () => {
            (navigator.clipboard?.writeText(email) ?? Promise.reject()).then(
                () => {
                    btn.style.width = `${btn.offsetWidth}px`;
                    btn.classList.add("done");
                    label.textContent = copied;
                    status.textContent = copiedMsg;
                    clearTimeout(timer);
                    timer = window.setTimeout(() => {
                        btn.classList.remove("done");
                        btn.style.width = "";
                        label.textContent = email;
                        status.textContent = "";
                    }, 2500);
                },
                () => {
                    getSelection()?.selectAllChildren(label);
                    status.textContent = selectedMsg;
                }
            );
        };
    });
</script>

<style>
    .hero {
        padding: 40px 0 48px;
    }
    .shell > * + * {
        margin-top: 20px;
    }
    h1 {
        font-size: clamp(48px, 14vw, 88px);
        line-height: 1;
        letter-spacing: -0.035em;
    }
    .lede {
        max-width: 640px;
        font-size: clamp(22px, 3vw, 28px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--soft);
    }
    .lede :global(strong) {
        color: var(--ink);
        font-weight: inherit;
    }
    .bio {
        max-width: 34em;
    }
    .bio :global(strong) {
        font-weight: 600;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 8px;
    }
    .btn svg {
        width: 18px;
        height: 18px;
        flex: none;
    }
    .btn .i-copy,
    .btn .i-check {
        width: 16px;
        height: 16px;
    }
    .i-check,
    .done .i-copy {
        display: none;
    }
    .done .i-check {
        display: block;
    }
    .email {
        user-select: text;
    }
    @media (max-width: 734px) {
        .actions .btn {
            flex: 1 1 0;
        }
        .actions .primary {
            flex-basis: 100%;
        }
    }
</style>
