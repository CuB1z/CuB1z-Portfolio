---
import Button from "@components/shared/Button.astro";
import ButtonIcon from "@components/shared/ButtonIcon.astro";
import { useTranslations } from "@utils/i18nUtils";
import { socialData } from "@/constants/socialData";

const t = useTranslations(Astro.currentLocale);

const email = socialData.email.replace(/^mailto:/, "");
---

<header class="hero">
    <div class="shell">
        <div class="hero-copy">
            <h1>{t("hero:name")}</h1>
            <p class="lede" set:html={t("hero:lede")} />
            <p class="bio" set:html={t("hero:bio")} />
            <div class="actions">
                <Button
                    variant="primary"
                    icon="mail"
                    id="copy-email"
                    data-email={email}
                    aria-label={t("hero:copy") + " " + email}
                    data-copied-msg={t("hero:copied_msg")}
                    data-selected-msg={t("hero:selected_msg")}
                >
                    <span class="email-label" aria-hidden="true">
                        <span class="email">{email}</span>
                        <span class="copied">{t("hero:copied")}</span>
                    </span>
                    <ButtonIcon name="copy" class="copy-icon" />
                    <ButtonIcon name="check" class="check-icon" />
                </Button>
                <div class="social-actions">
                    <Button href={socialData.github} icon="github" target="_blank" rel="noopener noreferrer">
                        GitHub
                    </Button>
                    <Button href={socialData.linkedin} icon="linkedin" target="_blank" rel="noopener noreferrer">
                        LinkedIn
                    </Button>
                </div>
            </div>
            <p class="vh" id="copy-status" role="status"></p>
        </div>
        <img
            class="hero-art"
            src="/images/hero-astronaut.webp"
            srcset="/images/hero-astronaut-384.webp 384w, /images/hero-astronaut-768.webp 768w, /images/hero-astronaut.webp 1402w"
            sizes="(max-width: 719px) min(100vw - 40px, clamp(200px, 36svh, 280px)), min(42vw - 23px, 384px)"
            alt=""
            width="1402"
            height="1122"
            fetchpriority="high"
        />
    </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        const btn = document.querySelector<HTMLButtonElement>("#copy-email");
        const label = btn?.querySelector<HTMLElement>(".email");
        const status = document.querySelector<HTMLElement>("#copy-status");
        if (!btn || !label || !status) return;
        const { email = "", copiedMsg = "", selectedMsg = "" } = btn.dataset;
        let timer: number | undefined;

        btn.onclick = async () => {
            try {
                if (!navigator.clipboard) throw new Error("Clipboard unavailable");
                await navigator.clipboard.writeText(email);
            } catch {
                clearTimeout(timer);
                btn.classList.remove("done");
                getSelection()?.selectAllChildren(label);
                status.textContent = selectedMsg;
                return;
            }

            btn.classList.add("done");
            status.textContent = copiedMsg;
            clearTimeout(timer);
            timer = window.setTimeout(() => {
                btn.classList.remove("done");
                status.textContent = "";
            }, 2500);
        };
    });
</script>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        padding: clamp(16px, 3vw, 40px) 0 clamp(24px, 4vw, 48px);
    }
    .hero::before {
        position: absolute;
        inset: calc(-1 * var(--main-top)) 0 0;
        z-index: -1;
        content: "";
        background-image:
            linear-gradient(to bottom, transparent 45%, var(--bg) 100%),
            url("/images/hero-obsidian.webp");
        background-position: center top;
        background-size: 100% 100%, max(100%, 58rem) auto;
        background-repeat: no-repeat;
    }
    .shell {
        display: grid;
        gap: clamp(16px, 3vw, 32px);
        align-items: center;
    }
    .hero-copy > * + * {
        margin-top: 16px;
    }
    h1 {
        font-size: clamp(36px, 7vw, 64px);
        line-height: 1;
        letter-spacing: -0.035em;
    }
    .lede {
        font-size: clamp(17px, 2.35vw, 23px);
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--soft);
    }
    .lede :global(strong) {
        color: var(--ink);
        font-weight: inherit;
    }
    .bio {
        max-width: 34em;
        font-size: clamp(15px, 1.65vw, 16px);
        text-wrap: pretty;
    }
    .bio :global(strong) {
        font-weight: 600;
    }
    .actions,
    .social-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }
    .actions {
        --button-padding-inline: 16px;
        --button-font-size: 14px;
    }
    .copy-icon,
    .check-icon {
        --button-icon-size: 16px;
    }
    .check-icon,
    :global(.done) .copy-icon {
        display: none;
    }
    :global(.done) .check-icon {
        display: block;
    }
    .email-label {
        display: grid;
    }
    .email-label > span {
        grid-area: 1 / 1;
    }
    .email {
        user-select: text;
    }
    .copied,
    :global(.done) .email {
        visibility: hidden;
    }
    :global(.done) .copied {
        visibility: visible;
    }
    .hero-art {
        display: block;
        justify-self: center;
        width: min(100%, clamp(200px, 36svh, 280px));
        height: auto;
    }
    @media (min-width: 720px) {
        .shell {
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        }
        .hero-art {
            justify-self: end;
            width: min(100%, 384px);
        }
    }
    @media (width < 720px) {
        .hero::before {
            background-position: 55% top;
        }
        .bio {
            max-width: none;
        }
    }
    @media (max-width: 480px) {
        .actions > :global(.btn),
        .social-actions {
            flex-basis: 100%;
        }
        .social-actions :global(.btn) {
            flex: 1 1 0;
        }
    }
</style>
