---
import { getCollection } from "astro:content";
import { useTranslations } from "@utils/i18nUtils";

import { buildUrl } from "@/utils/urlUtils";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
import PostRow from "@components/shared/PostRow.astro";
import { localePaths } from "@utils/i18nUtils";

export const getStaticPaths = localePaths;

const t = useTranslations(Astro.currentLocale);

const locale = Astro.currentLocale;

// Build log: TripFlow-tagged posts in this locale, oldest first.
const log = (await getCollection("post"))
    .filter(
        (p) =>
            (p.data.locale ?? "en") === locale &&
            p.data.showcase &&
            (p.data.tags ?? []).includes("TripFlow")
    )
    .sort(
        (a, b) =>
            new Date(a.data.pubDate).getTime() -
            new Date(b.data.pubDate).getTime()
    );

const problemPoints = t("tripflow:problem_points", { returnObjects: true }) as {
    text: string;
}[];
const compareCols = t("tripflow:compare_cols", { returnObjects: true }) as string[];
const compareRows = t("tripflow:compare_rows", { returnObjects: true }) as {
    feature: string;
    values: string[];
}[];
const features = t("tripflow:features", { returnObjects: true }) as {
    title: string;
    desc: string;
}[];
const archLayers = t("tripflow:arch_layers", { returnObjects: true }) as {
    name: string;
    tech: string;
    services?: string[];
    bus?: string;
}[];
const decisions = t("tripflow:decisions", { returnObjects: true }) as {
    title: string;
    desc: string;
}[];
const metrics = t("tripflow:metrics", { returnObjects: true }) as {
    value: string;
    label: string;
    sub: string;
}[];
const milestones = t("tripflow:milestones", { returnObjects: true }) as {
    version: string;
    name: string;
    desc: string;
}[];

const lastCol = compareCols.length - 1;

const live = "https://tripflow.cub1z.es";
const repo = "https://github.com/codeurjc-students/2025-TripFlow";
const image = "/images/projects/tripflow-showcase.webp";

const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const appLd = {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "TripFlow",
    applicationCategory: "TravelApplication",
    operatingSystem: "Web",
    description: t("tripflow:meta_description"),
    url: live,
    inLanguage: locale,
    author: { "@type": "Person", name: "Diego Sánchez Rincón", url: siteUrl },
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    keywords:
        "AI travel planning, microservices, Spring Boot, React, PWA, Kafka",
    image: new URL(image, Astro.site).toString(),
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Layout
    title={t("tripflow:meta_title")}
    description={t("tripflow:meta_description")}
    navActive="work"
>
    <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(appLd)}
    />

    <div class="shell">
        <header class="cs-hero">
            <div class="cs-hero-text">
                <Breadcrumb
                    items={[
                        { label: locale === "es" ? "Inicio" : "Home", href: buildUrl("/", locale) },
                        { label: t("common:nav.work"), href: `${buildUrl("/", locale)}#work` },
                        { label: "TripFlow" },
                    ]}
                />
                <h1 class="large-title">TripFlow</h1>
                <p class="lede">{t("tripflow:tagline")}</p>
                <div class="actions">
                    <a class="btn primary" href={live} target="_blank" rel="noopener noreferrer">{t("tripflow:live")}</a>
                    <a class="btn" href={repo} target="_blank" rel="noopener noreferrer">{t("tripflow:source")}</a>
                </div>
            </div>
            <img class="shot" src={image} alt={t("tripflow:image_alt")} loading="eager" />
        </header>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:problem_heading")}</h2>
            <p class="cs-lede">{t("tripflow:problem_lede")}</p>
            <ul class="group cs-list">
                {problemPoints.map((p) => <li>{p.text}</li>)}
            </ul>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:compare_heading")}</h2>
            <p class="cs-lede">{t("tripflow:compare_intro")}</p>
            <div class="group table-wrap">
                <table class="compare">
                    <thead>
                        <tr>
                            <td></td>
                            {
                                compareCols.map((c, i) => (
                                    <th scope="col" class:list={[{ own: i === lastCol }]}>{c}</th>
                                ))
                            }
                        </tr>
                    </thead>
                    <tbody>
                        {
                            compareRows.map((row) => (
                                <tr>
                                    <th scope="row">{row.feature}</th>
                                    {row.values.map((v, i) => (
                                        <td
                                            class:list={[
                                                {
                                                    yes: v === "✓",
                                                    dash: v === "—",
                                                    own: i === lastCol,
                                                },
                                            ]}
                                        >
                                            {v}
                                        </td>
                                    ))}
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:features_heading")}</h2>
            <p class="cs-lede">{t("tripflow:features_intro")}</p>
            <ul class="cards three">
                {
                    features.map((f) => (
                        <li class="card">
                            <h3>{f.title}</h3>
                            <p>{f.desc}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:arch_heading")}</h2>
            <p class="cs-lede">{t("tripflow:arch_intro")}</p>
            <div class="arch">
                {
                    archLayers.map((layer, i) => (
                        <>
                            <div class:list={["layer", { wide: !!layer.services }]}>
                                <span class="layer-name">{layer.name}</span>
                                <span class="layer-tech">{layer.tech}</span>
                                {layer.services && (
                                    <div class="services">
                                        {layer.services.map((s) => (
                                            <span class="svc">{s}</span>
                                        ))}
                                    </div>
                                )}
                                {layer.bus && <div class="bus">{layer.bus}</div>}
                            </div>
                            {i < archLayers.length - 1 && <div class="connector" aria-hidden="true" />}
                        </>
                    ))
                }
            </div>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:decisions_heading")}</h2>
            <p class="cs-lede">{t("tripflow:decisions_intro")}</p>
            <ul class="cards">
                {
                    decisions.map((d) => (
                        <li class="card">
                            <h3>{d.title}</h3>
                            <p>{d.desc}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:metrics_heading")}</h2>
            <p class="cs-lede">{t("tripflow:metrics_intro")}</p>
            <ul class="metrics">
                {
                    metrics.map((m) => (
                        <li class="card">
                            <span class="metric-val">{m.value}</span>
                            <span class="metric-label">{m.label}</span>
                            <span class="metric-sub">{m.sub}</span>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="cs-section">
            <h2 class="sec-title">{t("tripflow:journey_heading")}</h2>
            <p class="cs-lede">{t("tripflow:journey_intro")}</p>
            <ol class="group timeline">
                {
                    milestones.map((m) => (
                        <li class="role">
                            <div class="role-head">
                                <h3>{m.name}</h3>
                                <div class="meta"><span class="chip">{m.version}</span></div>
                            </div>
                            <p>{m.desc}</p>
                        </li>
                    ))
                }
            </ol>
            <p class="log-intro">{t("tripflow:log_intro")}</p>
            <ul class="group">
                {log.map((post) => <PostRow post={post} />)}
            </ul>
        </section>
    </div>
</Layout>

<style>
    .cs-hero {
        display: grid;
        gap: 32px;
        padding: 8px 0 32px;
    }
    .cs-hero-text {
        display: grid;
        gap: 20px;
        min-width: 0;
    }
    .lede {
        font-size: clamp(20px, 2.2vw, 24px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--soft);
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .shot {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    .cs-section {
        padding: 40px 0;
    }
    .cs-section .sec-title {
        margin-bottom: 12px;
    }
    .cs-lede {
        max-width: 40em;
        margin-bottom: 24px;
        color: var(--soft);
    }
    .cs-list > li {
        padding: 16px 24px;
    }

    .table-wrap {
        overflow-x: auto;
    }
    .compare {
        width: 100%;
        min-width: 576px;
        border-collapse: collapse;
        font-size: 15px;
    }
    .compare :is(th, td) {
        padding: 14px 16px;
        border-bottom: 1px solid var(--rule);
        text-align: center;
        white-space: nowrap;
    }
    .compare tbody tr:last-child > * {
        border-bottom: 0;
    }
    .compare thead th {
        font-size: 13px;
        font-weight: 600;
        color: var(--mute);
    }
    .compare tr > :first-child {
        position: sticky;
        left: 0;
        background: var(--bg-card);
        text-align: left;
        font-weight: 500;
    }
    .compare .yes {
        color: var(--accent);
    }
    .compare .dash {
        color: var(--mute);
    }
    .compare .own {
        background: var(--accent-dim);
        color: var(--accent);
        font-weight: 600;
    }

    .cards,
    .metrics {
        list-style: none;
        display: grid;
        gap: 12px;
    }
    .card {
        display: grid;
        gap: 6px;
        align-content: start;
        padding: 20px 22px;
        border-radius: 18px;
        background: var(--bg-card);
    }
    .card h3 {
        font-size: 17px;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: normal;
    }
    .card p {
        font-size: 15px;
        color: var(--soft);
    }

    .arch {
        display: grid;
        justify-items: center;
    }
    .layer {
        display: grid;
        gap: 4px;
        width: min(100%, 448px);
        padding: 16px 20px;
        border-radius: 18px;
        background: var(--bg-card);
        text-align: center;
    }
    .layer.wide {
        width: min(100%, 640px);
    }
    .layer-name {
        font-weight: 600;
    }
    .layer-tech {
        font-size: 13px;
        color: var(--mute);
    }
    .services {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
        margin-top: 8px;
    }
    .svc {
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--fill);
        font-size: 14px;
    }
    .bus {
        margin-top: 8px;
        padding: 8px 16px;
        border-radius: 12px;
        background: var(--accent-dim);
        color: var(--accent);
        font-size: 14px;
        font-weight: 600;
    }
    .connector {
        width: 2px;
        height: 24px;
        background: linear-gradient(var(--accent), var(--accent-dim));
    }

    .metrics {
        grid-template-columns: repeat(auto-fit, minmax(208px, 1fr));
    }
    .metric-val {
        font-size: 36px;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
    }
    .metric-label {
        font-weight: 600;
    }
    .metric-sub {
        font-size: 13px;
        color: var(--mute);
    }

    .log-intro {
        margin: 32px 0 16px;
        color: var(--soft);
    }

    @media (min-width: 640px) {
        .cards {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (min-width: 900px) {
        .cs-hero {
            grid-template-columns: 1fr 1.1fr;
            align-items: center;
        }
        .cards.three {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 734px) {
        .cs-list > li {
            padding-inline: 20px;
        }
    }
</style>
