---
import { useTranslations } from "@utils/i18nUtils";
import { getCollection } from "astro:content";

import { buildUrl } from "@/utils/urlUtils";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
import Chevron from "@components/shared/Chevron.astro";
import PostRow from "@components/shared/PostRow.astro";
import { localePaths } from "@utils/i18nUtils";

export const getStaticPaths = localePaths;

const t = useTranslations(Astro.currentLocale);

const locale = Astro.currentLocale;

const allPosts = await getCollection("post");
const posts = allPosts
    .filter((post) => (post.data.locale ?? "en") === locale)
    .sort(
        (a, b) =>
            new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );

const PER_PAGE = 6;
const pages = Array.from({ length: Math.ceil(posts.length / PER_PAGE) }, (_, i) =>
    posts.slice(i * PER_PAGE, (i + 1) * PER_PAGE)
);
---

<Layout navActive="writing" title={`${t("blog:heading")} · Diego Sánchez Rincón`}>
    <div class="shell">
        <header class="page-head">
            <Breadcrumb
                items={[
                    { label: locale === "es" ? "Inicio" : "Home", href: buildUrl("/", locale) },
                    { label: t("blog:heading") },
                ]}
            />
            <h1 class="large-title">{t("blog:heading")}</h1>
        </header>

        {
            pages.map((page) => (
                <ul class="group post-page">
                    {page.map((post) => (
                        <PostRow post={post} level="h2" excerpt tags />
                    ))}
                </ul>
            ))
        }

        {
            pages.length > 1 && (
                <nav class="pager" aria-label="Pagination" hidden>
                    <button type="button" data-rel="prev" aria-label="Previous page"><Chevron back /></button>
                    {pages.map((_, i) => (
                        <button type="button" class="pg-num">{i + 1}</button>
                    ))}
                    <button type="button" data-rel="next" aria-label="Next page"><Chevron /></button>
                </nav>
            )
        }
    </div>
</Layout>

<style>
    .page-head {
        display: grid;
        gap: 12px;
        padding: 8px 0 32px;
    }
    .post-page + .post-page {
        margin-top: 12px;
    }
    .pager {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
    }
    .pager button {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 50%;
        background: var(--fill);
        color: var(--ink);
        font: 600 15px/1 var(--font-sans);
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        transition: color 0.2s;
    }
    .pager button:hover:not(:disabled, .current) {
        color: var(--accent);
    }
    .pager button.current {
        background: var(--accent);
        color: var(--bg);
    }
    .pager button:disabled {
        opacity: 0.4;
        cursor: default;
    }
    .pager :global(.chev) {
        width: 14px;
        height: 14px;
    }
</style>
