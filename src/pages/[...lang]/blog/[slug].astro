---
import { getCollection, render } from "astro:content";
import { DEFAULT_LOCALE, useTranslations } from "@utils/i18nUtils";

import { buildAltLangUrl, buildUrl } from "@/utils/urlUtils";
import { formatDate } from "@/utils/formatUtils";
import { socialData } from "@/constants/socialData";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/shared/Breadcrumb.astro";
import PostRow from "@components/shared/PostRow.astro";
import Chevron from "@components/shared/Chevron.astro";

export async function getStaticPaths() {
    const posts = await getCollection("post");

    return posts.map((post) => {
        const lang = post.data.locale === DEFAULT_LOCALE ? undefined : post.data.locale;
        const slug = post.data.slug || post.id;
        return { params: { lang, slug }, props: post };
    });
}

const post = Astro.props;
const { Content, headings } = await render(post);
const currentLocale = Astro.currentLocale;
const t = useTranslations(currentLocale);

const toc = headings.filter((h) => h.depth === 2);
const altLangUrl = buildAltLangUrl(`/blog/${post.data.altSlug}`, currentLocale);

const authorName = "Diego Sánchez Rincón";
const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const authorImage = `${siteUrl}/images/diego-sanchez.webp`;
const canonicalHref = new URL(Astro.url.pathname, Astro.site).toString();

const blogPostingLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate && {
        dateModified: post.data.updatedDate.toISOString(),
    }),
    inLanguage: currentLocale,
    ...(post.data.image && {
        image: new URL(post.data.image, Astro.site).toString(),
    }),
    ...(post.data.tags && { keywords: post.data.tags }),
    author: { "@type": "Person", name: authorName, url: siteUrl, image: authorImage },
    mainEntityOfPage: canonicalHref,
};

const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(words / 200));

// Related posts: same locale, ranked by shared tags then recency.
const myTags = new Set(post.data.tags ?? []);
const sharedTags = (p: typeof post) =>
    (p.data.tags ?? []).filter((tag) => myTags.has(tag)).length;
const related = (await getCollection("post"))
    .filter((p) => p.id !== post.id && (p.data.locale ?? "en") === currentLocale)
    .sort(
        (a, b) =>
            sharedTags(b) - sharedTags(a) ||
            b.data.pubDate.getTime() - a.data.pubDate.getTime()
    )
    .slice(0, 3);
---

<Layout
    title={`${post.data.title} · Diego Sánchez Rincón`}
    description={post.data.description}
    altLangUrl={altLangUrl}
    navActive="writing"
>
    <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(blogPostingLd)}
    />
    <div class="shell">
        <article class="article">
            <header class="p-head">
                <Breadcrumb
                    items={[
                        { label: currentLocale === "es" ? "Inicio" : "Home", href: buildUrl("/", currentLocale) },
                        { label: t("blog:heading"), href: buildUrl("/blog", currentLocale) },
                        { label: post.data.title },
                    ]}
                />
                <h1 class="large-title">{post.data.title}</h1>
                <p class="p-meta">
                    {t("blog:by")} {authorName} ·{" "}
                    <time datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate, currentLocale)}
                    </time>
                    {
                        post.data.updatedDate && (
                            <>
                                {" "}·{" "}
                                <time datetime={post.data.updatedDate.toISOString()}>
                                    {t("blog:updated")} {formatDate(post.data.updatedDate, currentLocale)}
                                </time>
                            </>
                        )
                    }
                    {" "}· {readingTime} {t("blog:min_read")}
                </p>
                {
                    post.data.tags && (
                        <ul class="tags">
                            {post.data.tags.map((tag) => (
                                <li>{tag}</li>
                            ))}
                        </ul>
                    )
                }
            </header>

            {
                post.data.image && (
                    <img class="cover" src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="eager" />
                )
            }

            <div class="post-content">
                <Content />
            </div>

            {
                related.length > 0 && (
                    <section>
                        <h2 class="sub">{t("blog:read_next")}</h2>
                        <ul class="group">
                            {related.map((r) => (
                                <PostRow post={r} />
                            ))}
                        </ul>
                    </section>
                )
            }

            <aside class="author-card">
                <div class="profile">
                    <img src="/images/diego-192.webp" width="64" height="64" alt="" loading="lazy" />
                    <div>
                        <p class="profile-name">{authorName}</p>
                        <p class="profile-sub">{t("common:schema.jobTitle")}</p>
                    </div>
                </div>
                <p class="a-bio" set:html={t("blog:author_bio")} />
                <div class="a-links">
                    <a href={socialData.github} target="_blank" rel="noopener noreferrer">GitHub</a>
                    <a href={socialData.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                </div>
            </aside>

            <a class="more all-posts" href={buildUrl("/blog", currentLocale)}>
                <Chevron back />
                {t("blog:back")}
            </a>
        </article>

        {
            toc.length > 0 && (
                <>
                    <button class="toc-btn" type="button" popovertarget="toc" aria-label={t("blog:on_this_page")}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    </button>
                    <nav class="toc" id="toc" popover aria-label={t("blog:on_this_page")}>
                        <p class="toc-title">{t("blog:on_this_page")}</p>
                        {toc.map((h) => (
                            <a href={`#${h.slug}`}>{h.text}</a>
                        ))}
                    </nav>
                </>
            )
        }
    </div>
</Layout>

<style>
    .article {
        padding-top: 8px;
        display: grid;
        gap: 32px;
    }
    .p-head {
        display: grid;
        gap: 12px;
    }
    .p-meta {
        font-size: 15px;
        color: var(--soft);
    }
    .p-head .tags {
        margin-top: 4px;
    }
    .cover {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: var(--radius);
    }
    .sub {
        margin-top: 0;
    }

    .author-card {
        display: grid;
        gap: 14px;
        padding: 24px;
        border-radius: var(--radius);
        background: var(--bg-card);
    }
    .author-card .profile img {
        box-shadow: 0 0 0 2px var(--bg-card), 0 0 0 3.5px var(--accent);
    }
    .a-bio {
        font-size: 15px;
        color: var(--soft);
    }
    .a-links {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 20px;
    }
    .a-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--accent);
    }
    .a-links a:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    .all-posts {
        justify-self: start;
        margin-top: -16px;
    }

    .toc-btn {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 50;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(16, 20, 26, 0.72);
        backdrop-filter: blur(20px) saturate(180%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        color: var(--ink);
        cursor: pointer;
        transition: color 0.2s;
    }
    .toc-btn:hover {
        color: var(--accent);
    }
    .toc-btn svg {
        width: 20px;
        height: 20px;
    }
    .toc {
        position: fixed;
        inset: auto 24px 88px auto;
        margin: 0;
        width: min(300px, calc(100vw - 48px));
        max-height: min(60vh, 480px);
        overflow-y: auto;
        padding: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        background: rgba(16, 20, 26, 0.92);
        backdrop-filter: blur(20px) saturate(180%);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        color: var(--ink);
    }
    .toc:popover-open {
        display: grid;
        gap: 2px;
        animation: toc-in 0.16s ease-out;
    }
    @keyframes toc-in {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }
    }
    .toc-title {
        padding: 8px 12px 6px;
        font-size: 13px;
        font-weight: 600;
        color: var(--mute);
    }
    .toc a {
        padding: 8px 12px;
        border-radius: 10px;
        color: var(--soft);
        font-size: 14px;
        line-height: 1.35;
        transition: background-color 0.2s, color 0.2s;
    }
    .toc a:hover {
        background: var(--fill);
        color: var(--ink);
    }
    .toc a.active {
        background: var(--fill);
        color: var(--accent);
    }
    @media (max-width: 734px) {
        .toc-btn {
            right: 16px;
            bottom: 16px;
        }
        .toc {
            inset: auto 16px 80px auto;
            width: min(300px, calc(100vw - 32px));
        }
    }

    .post-content {
        min-width: 0;
        color: color-mix(in srgb, var(--ink) 70%, var(--soft));
        font-size: 17px;
        line-height: 1.7;
        overflow-wrap: break-word;
    }
    .post-content > :global(* + *) {
        margin-top: 1.1em;
    }
    .post-content :global(h2) {
        font-size: 24px;
        line-height: 1.25;
        letter-spacing: -0.015em;
        margin-top: 2.25em;
        scroll-margin-top: 96px;
    }
    .post-content :global(h3) {
        font-size: 20px;
        font-weight: 600;
        line-height: 1.3;
        margin-top: 1.75em;
        scroll-margin-top: 96px;
    }
    .post-content :global(:is(h2, h3) + *) {
        margin-top: 0.75em;
    }
    .post-content :global(ul) {
        list-style: disc;
        padding-left: 1.25rem;
    }
    .post-content :global(ol) {
        list-style: decimal;
        padding-left: 1.25rem;
    }
    .post-content :global(:is(ul, ol)) {
        color: color-mix(in srgb, var(--ink) 55%, var(--soft));
    }
    .post-content :global(li + li) {
        margin-top: 0.4em;
    }
    .post-content :global(li::marker) {
        color: var(--accent);
    }
    .post-content :global(strong) {
        font-weight: 600;
        color: var(--ink);
    }
    .post-content :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: var(--accent-dim);
        text-underline-offset: 0.2em;
    }
    .post-content :global(a:hover) {
        text-decoration-color: var(--accent);
    }
    .post-content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.875em;
        padding: 0.125em 0.375em;
        border-radius: 6px;
        background: var(--fill);
    }
    .post-content :global(pre) {
        background: var(--bg-card) !important;
        border-radius: 16px;
        padding: 16px 20px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
    }
    .post-content :global(pre code) {
        padding: 0;
        background: none;
        font-size: inherit;
    }
    .post-content :global(blockquote) {
        padding: 16px 20px;
        border-radius: 16px;
        background: var(--bg-card);
        color: var(--soft);
    }
    .post-content :global(blockquote > * + *) {
        margin-top: 0.5em;
    }
    .post-content :global(blockquote :is(ul, ol)) {
        color: inherit;
    }
    .post-content :global(blockquote strong) {
        color: var(--ink);
    }
    .post-content :global(hr) {
        border: 0;
        height: 1px;
        background: var(--rule);
        margin-block: 40px;
    }
    .post-content :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 16px;
    }
    .post-content :global(iframe) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        border: 0;
        border-radius: 16px;
    }
</style>
