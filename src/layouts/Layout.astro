---
import { useTranslations } from "@utils/i18nUtils";

import { ClientRouter } from "astro:transitions";

import Nav from "@components/shared/Nav.astro";
import Footer from "@components/shared/Footer.astro";
import { socialData } from "@/constants/socialData";

const t = useTranslations(Astro.currentLocale);

interface Props {
    title?: string;
    description?: string;
    altLangUrl?: string;
    navActive?: string;
    home?: boolean;
}

const {
    title,
    description,
    altLangUrl,
    navActive,
    home = false,
} = Astro.props as Props;

const locale = Astro.currentLocale;

const pageTitle = title ?? t("title");
const pageDescription = description ?? t("description");

const currentPath = Astro.url.pathname;
const isEs = currentPath.startsWith("/es");
const cleanPath = isEs ? currentPath.replace(/^\/es/, "") : currentPath;

const enUrl =
    locale === "es" && altLangUrl
        ? new URL(altLangUrl, Astro.site)
        : new URL(cleanPath, Astro.site);
const esUrl =
    locale === "en" && altLangUrl
        ? new URL(altLangUrl, Astro.site)
        : new URL(`/es${cleanPath === "/" ? "/" : cleanPath}`, Astro.site);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const email = socialData.email.replace(/^mailto:/, "");

const jobTitle = t("schema.jobTitle");
const knowsAbout = t("schema.knowsAbout", { returnObjects: true }) as string[];

const personLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Diego Sánchez Rincón",
    alternateName: ["Diego Sánchez", "CuB1z"],
    givenName: "Diego",
    familyName: "Sánchez Rincón",
    url: siteUrl,
    image: `${siteUrl}/images/diego-sanchez.webp`,
    jobTitle,
    description: pageDescription,
    worksFor: { "@type": "Organization", name: "Génexys Technology" },
    alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Universidad Rey Juan Carlos",
    },
    address: {
        "@type": "PostalAddress",
        addressLocality: "Madrid",
        addressCountry: "ES",
    },
    email,
    knowsAbout,
    sameAs: [socialData.github, socialData.linkedin],
};

const websiteLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: `Diego Sánchez Rincón · ${jobTitle}`,
    alternateName: ["Diego Sánchez", "CuB1z"],
    url: siteUrl,
    description: pageDescription,
    inLanguage: locale,
    author: { "@type": "Person", name: "Diego Sánchez Rincón", url: siteUrl },
};
---

<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />

        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={pageTitle} />
        <meta property="twitter:description" content={pageDescription} />
        <meta property="twitter:image" content={new URL("/og-image.png", Astro.site)} />

        <link rel="icon" href="/favicon.svg" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Diego Sánchez Rincón · Blog"
            href={isEs ? "/es/rss.xml" : "/rss.xml"}
        />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(websiteLd)}
        />
        {
            home && (
                <script
                    type="application/ld+json"
                    set:html={JSON.stringify(personLd)}
                />
            )
        }
        <slot name="head" />

        <link
            rel="preload"
            href="/fonts/geist.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />

        <ClientRouter />
    </head>
    <body>
        <Nav home={home} active={navActive} altLangUrl={altLangUrl} />
        <main><slot /></main>
        <Footer />

        <script>
            // Active-section + table-of-contents highlighting.
            // Re-runs on every navigation so it keeps working with view transitions.
            let navObserver: IntersectionObserver | undefined;
            let tocObserver: IntersectionObserver | undefined;

            function initNav() {
                navObserver?.disconnect();
                const links = Array.from(
                    document.querySelectorAll<HTMLAnchorElement>(".nav-links a")
                );
                const sections = Array.from(document.querySelectorAll("section[id]"));
                if (!links.length || !sections.length) return;
                const setActive = (id: string) =>
                    links.forEach((a) =>
                        a.classList.toggle("active", a.getAttribute("href") === "#" + id)
                    );
                navObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((e) => {
                            if (e.isIntersecting) setActive((e.target as HTMLElement).id);
                        });
                    },
                    { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
                );
                sections.forEach((s) => navObserver!.observe(s));
            }

            function initToc() {
                tocObserver?.disconnect();
                const links = Array.from(
                    document.querySelectorAll<HTMLAnchorElement>(".toc a")
                );
                const headings = Array.from(
                    document.querySelectorAll<HTMLElement>(".post-content h2[id]")
                );
                if (!links.length || !headings.length) return;
                const setActive = (id: string) =>
                    links.forEach((a) =>
                        a.classList.toggle("active", a.getAttribute("href") === "#" + id)
                    );
                tocObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((e) => {
                            if (e.isIntersecting) setActive((e.target as HTMLElement).id);
                        });
                    },
                    { rootMargin: "-96px 0px -65% 0px", threshold: 0 }
                );
                headings.forEach((h) => tocObserver!.observe(h));
                if (headings[0]) setActive(headings[0].id);
            }

            function initPager() {
                const list = document.querySelector<HTMLElement>(".list");
                const pager = document.querySelector<HTMLElement>(".pager");
                if (!list || !pager) return;
                const posts = Array.from(list.querySelectorAll<HTMLElement>(".post"));
                const numBtns = Array.from(
                    pager.querySelectorAll<HTMLButtonElement>(".pg-num")
                );
                const prev = pager.querySelector<HTMLButtonElement>('[data-rel="prev"]');
                const next = pager.querySelector<HTMLButtonElement>('[data-rel="next"]');
                if (!numBtns.length || !prev || !next) return;
                const PER = 4;
                const pages = numBtns.length;
                let current = 1;
                const go = (n: number, scroll = false) => {
                    current = Math.min(Math.max(1, n), pages);
                    posts.forEach((p, idx) => {
                        p.style.display =
                            Math.floor(idx / PER) + 1 === current ? "" : "none";
                    });
                    numBtns.forEach((b, i) =>
                        b.classList.toggle("current", i + 1 === current)
                    );
                    prev.disabled = current === 1;
                    next.disabled = current === pages;
                    if (scroll) {
                        const head = document.querySelector<HTMLElement>(".page-head");
                        const y = head
                            ? head.getBoundingClientRect().top + window.scrollY - 90
                            : 0;
                        window.scrollTo({ top: Math.max(0, y), behavior: "smooth" });
                    }
                };
                numBtns.forEach((b, i) => (b.onclick = () => go(i + 1, true)));
                prev.onclick = () => go(current - 1, true);
                next.onclick = () => go(current + 1, true);
                pager.hidden = false;
                go(1);
            }

            document.addEventListener("astro:page-load", () => {
                initNav();
                initToc();
                initPager();
            });
        </script>
    </body>
</html>

<style is:global>
    @font-face {
        font-family: "Geist";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/geist.woff2") format("woff2");
    }
    @font-face {
        font-family: "Geist Mono";
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url("/fonts/geist-mono.woff2") format("woff2");
    }

    *,
    *::before,
    *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        scrollbar-width: thin;
        scrollbar-color: var(--mute) transparent;
        -webkit-tap-highlight-color: transparent;
    }

    :root {
        --font-sans: "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;

        --bg: #0a0c10;
        --bg-card: #10141a;
        --bg-card-2: #151a21;
        --fill: #1a2029;
        --ink: #f3f7fb;
        --soft: #a7b1bd;
        --mute: #7a8492;
        --rule: #1f2630;
        --accent: #73b3d8;
        --accent-dim: rgba(115, 179, 216, 0.16);

        --radius: 22px;
        --max-width: 1056px;
    }

    html {
        scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }

    body {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--ink);
        font-size: 17px;
        font-weight: 500;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
    }

    ::selection {
        background: var(--accent);
        color: var(--bg);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.15;
        font-weight: 700;
        text-wrap: balance;
    }

    main {
        flex: 1;
        padding: 112px 0 32px;
    }

    .shell {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 20px;
    }

    .section {
        padding: 56px 0;
        scroll-margin-top: 88px;
    }

    .sec-title {
        font-size: clamp(28px, 4vw, 40px);
        line-height: 1.1;
        letter-spacing: -0.025em;
        margin-bottom: 24px;
    }

    .sub {
        font-size: 20px;
        font-weight: 600;
        line-height: 1.25;
        margin: 40px 0 16px;
    }

    .large-title {
        font-size: clamp(36px, 6vw, 52px);
        line-height: 1.08;
        letter-spacing: -0.03em;
    }

    .group {
        list-style: none;
        background: var(--bg-card);
        border-radius: var(--radius);
        overflow: hidden;
    }
    .group > li,
    .group > div {
        position: relative;
    }
    .group > li + li::before,
    .group > div + div::before {
        content: "";
        position: absolute;
        top: 0;
        left: 24px;
        right: 24px;
        height: 1px;
        background: var(--rule);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        list-style: none;
    }
    .tags > * {
        padding: 3px 9px;
        border-radius: 999px;
        background: var(--fill);
        color: var(--soft);
        font-size: 12px;
        line-height: 1.4;
    }

    .chip {
        padding: 4px 10px;
        border-radius: 999px;
        background: var(--accent-dim);
        color: var(--accent);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .chev {
        width: 12px;
        height: 12px;
        flex: none;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 20px;
        border: 0;
        border-radius: 999px;
        background: var(--fill);
        color: var(--ink);
        font: 500 16px/1 var(--font-sans);
        cursor: pointer;
        transition: filter 0.2s;
    }
    .btn:hover {
        filter: brightness(1.15);
    }
    .btn.primary {
        background: var(--accent);
        color: var(--bg);
    }

    .more {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        min-height: 44px;
        color: var(--accent);
    }
    .more:hover {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    .timeline > li + li::before {
        content: none;
    }
    .role {
        display: grid;
        gap: 14px;
        padding: 24px 24px 24px 52px;
    }
    .role::after {
        content: "";
        position: absolute;
        left: 24px;
        top: 31.5px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-dim);
    }
    .timeline > .role:not(:last-child)::before {
        content: "";
        position: absolute;
        left: 28px;
        right: auto;
        top: 44px;
        bottom: -29.6px;
        width: 2px;
        height: auto;
        background: linear-gradient(var(--accent), var(--accent-dim));
    }
    .role-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 4px 24px;
    }
    .role h3 {
        font-size: 20px;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: -0.01em;
    }
    .meta {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        font-size: 13px;
        color: var(--mute);
        font-variant-numeric: tabular-nums;
    }

    .profile {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .profile img {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
        flex: none;
        box-shadow: 0 0 0 2px var(--bg), 0 0 0 3.5px var(--accent);
    }
    .profile-name {
        font-weight: 600;
        line-height: 1.3;
    }
    .profile-sub {
        font-size: 14px;
        color: var(--soft);
    }

    .vh {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 734px) {
        main {
            padding-top: 88px;
        }
        .section {
            padding: 40px 0;
        }
        .group > li + li::before,
        .group > div + div::before {
            left: 20px;
            right: 20px;
        }
        .role {
            padding: 20px 20px 20px 44px;
        }
        .role::after {
            left: 18px;
            top: 27.5px;
        }
        .timeline > .role:not(:last-child)::before {
            left: 22px;
            top: 40px;
            bottom: -25.6px;
        }
    }

    @media (max-width: 480px) {
        .role-head {
            flex-direction: column;
            gap: 10px;
        }
        .meta {
            align-items: flex-start;
        }
    }
</style>
